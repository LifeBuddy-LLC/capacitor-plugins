<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:drawable="@drawable/victory_mode">
  <target
    android:name="left_arm"
    android:animation="@animator/arms_down_up"/>
    <target
    android:name="left_upper_arm"
    android:animation="@animator/arms_down_up_reverse"/>
  <target
    android:name="right_arm"
    android:animation="@animator/arms_down_up_reverse"/>
    <target
    android:name="right_upper_arm"
    android:animation="@animator/arms_down_up"/>
</animated-vector>
