<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
  android:duration="5000"
  android:repeatCount="infinite"
  android:valueType="floatType">
  <propertyValuesHolder android:propertyName="translateX">
    <keyframe android:fraction="0" android:value="-300" />
    <!-- <keyframe android:fraction="0.05" android:value="-10" /> -->
    <keyframe android:fraction="0.2" android:value="0" />
    <!-- <keyframe android:fraction="0.2" android:value="15" /> -->
    <!-- <keyframe android:fraction="0.95" android:value="-10" /> -->
    <keyframe android:fraction="1" android:value="0" />
  </propertyValuesHolder>
  <propertyValuesHolder android:propertyName="translateY">
    <keyframe android:fraction="0" android:value="0" />
    <!-- <keyframe android:fraction="0.05" android:value="-10" /> -->
    <keyframe android:fraction="0.4" android:value="0" />
    <keyframe android:fraction="0.6" android:value="-300" />
    <!-- <keyframe android:fraction="0.2" android:value="15" /> -->
    <!-- <keyframe android:fraction="0.95" android:value="-10" /> -->
    <keyframe android:fraction="1" android:value="-300" />
  </propertyValuesHolder>
</objectAnimator>
