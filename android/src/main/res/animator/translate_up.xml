    <keyframe android:fraction="0.2" android:value="100" />
    <keyframe android:fraction="0.3" android:value="0" />
    <keyframe android:fraction="0.7" android:value="0" />
    <!-- <keyframe android:fraction="0.95" android:value="-10" /> -->
    <keyframe android:fraction="1" android:value="-500" />
  </propertyValuesHolder>
</objectAnimator>
